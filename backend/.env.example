# Inject rotated secrets through the deployment secret manager. Do not reuse removed source credentials.
APP_ENV=production
PORT=4000
AUTH_ALLOWED_ORIGINS=https://shop.example.invalid
AUTH_TRUST_PROXY=
MONGODB_URI=
GOOGLE_APPLICATION_CREDENTIALS=
WHATSAPP_ACCESS_TOKEN=
# Explicit supported Graph API version (vNN.N) and the existing sender phone-number ID.
WHATSAPP_API_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
VERIFY_TOKEN=
SMTP_USER=
SMTP_PASSWORD=
# Disabled until the operator verifies existing/rotated VAPID keys and real browser delivery.
ADMIN_PUSH_ENABLED=false
COMMERCE_TELEMETRY_ENABLED=false
# Temporary pharmacist image mapping/review/export/import module. No AI API key required.
IMAGE_REVIEW_ENABLED=false
IMAGE_REVIEW_HOSTED_PUBLICATION=false
ADMIN_PUSH_SUBJECT=
ADMIN_PUSH_PUBLIC_KEY=
ADMIN_PUSH_PRIVATE_KEY=
# Only ADMIN_PUSH_PUBLIC_KEY is shared with the Next server; private key remains API-only.
# Keep frontend and /api + /socket.io on the same HTTPS origin via fixed upstream routing.
# backend/.env.local is ignored for explicit local development; backend/.env is no longer loaded.

# Optional customer sign-in. Configure privately; never use NEXT_PUBLIC_* for secrets.
# Google: OAuth Web application client ID; requires exact authorized storefront origins.
CUSTOMER_GOOGLE_CLIENT_ID=
# Email code sign-in: independent random secret (32+ characters) and Microsoft 365 SMTP mailbox.
CUSTOMER_AUTH_SECRET=
CUSTOMER_EMAIL_USER=
CUSTOMER_EMAIL_PASSWORD=

# Automated email: Resend (server-only). Keep existing Microsoft 365 MX records.
# Leave EMAIL_PROVIDER blank to retain the legacy SMTP adapter.
EMAIL_PROVIDER=
RESEND_API_KEY=
RESEND_MARKETING_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_TRANSACTIONAL_DOMAIN=notify.alminapharmacy.com
EMAIL_MARKETING_DOMAIN=news.alminapharmacy.com
EMAIL_REPLY_TO=info@alminapharmacy.com
EMAIL_PUBLIC_API_ORIGIN=https://almina-of4b.onrender.com
GROWTH_WEB_ORIGIN=https://alminapharmacy.com
# Requested reminders also require the admin retention policy to be enabled.
GROWTH_EMAIL_ENABLED=false
MARKETING_EMAIL_ENABLED=false
MARKETING_POSTAL_ADDRESS=
MARKETING_TEST_RECIPIENTS=
MARKETING_OUTLOOK_MAILBOX=
MARKETING_OUTLOOK_TENANT_ID=
MARKETING_OUTLOOK_CLIENT_ID=
MARKETING_OUTLOOK_CLIENT_SECRET=

# Intelligent discovery: enable Atlas only after indexes/backfill/staging verification.
SEARCH_PROVIDER=legacy
ATLAS_SEARCH_PRODUCT_INDEX=products_search
ATLAS_VECTOR_PRODUCT_INDEX=products_vector
SEARCH_SEMANTIC_ENABLED=false
SEARCH_EMBEDDING_WORKER_ENABLED=false
SEARCH_ANALYTICS_ENABLED=false
# Offline embedding jobs only; never expose this key to a browser.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
SEARCH_EMBEDDING_DIMENSIONS=768
# SEARCH_EMBEDDING_API_KEY=inject-through-secret-manager
