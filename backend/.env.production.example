# Full persistent Render API. Templates are never automatically loaded.
APP_ENV=production
NODE_ENV=production
AUTH_ALLOWED_ORIGINS=https://www.alminapharmacy.com
AUTH_TRUST_PROXY=
# Reviewed production Atlas URI/database; inject in Render only.
MONGODB_URI=
ADMIN_PUSH_ENABLED=false
COMMERCE_TELEMETRY_ENABLED=false
# Configure rotated provider credentials in Render, never in the frontend.
# Preserve existing media/integration configuration until its staged acceptance.

# Checkout address autofill. Shared MongoDB lease/cache enforce provider throttling.
# Apply additive API indexes for cache/quota expiry. Public Nominatim has no SLA;
# move to a managed/self-hosted Nominatim endpoint for a contractual SLA or growth.
GEOCODING_ENABLED=true
GEOCODING_REVERSE_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_USER_AGENT=AlMinaPharmacy/1.0 (+https://alminapharmacy.com/contact)
GEOCODING_DAILY_LIMIT=500
