{
  "name": "almina",
  "version": "1.0.0",
  "description": "Al Mina Next.js storefront and administration with maintained Express commerce API",
  "scripts": {
    "build": "npm ci --include=dev && npm ci --prefix backend && npm run build:commerce",
    "start": "node backend/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:unit": "tsx --test tests/commerce.test.ts tests/commerce-policy.test.ts tests/contracts.test.ts tests/env.test.ts tests/storefront.test.ts tests/seo.test.ts tests/logger.test.ts tests/client.test.ts tests/performance.test.ts tests/render-deployment.test.ts tests/next-lint.test.ts tests/retained-ownership.test.ts tests/recovery-import.test.ts tests/operations.test.ts tests/media.test.ts tests/email-provider.test.ts tests/retained-runtime.test.ts tests/drive-provider.test.ts tests/whatsapp-outbound.test.ts tests/whatsapp-retry.test.ts tests/whatsapp-reads.test.ts tests/order-reads.test.ts tests/catalog-media-reads.test.ts tests/persistent-database.test.ts tests/session-ownership.test.ts tests/retained-auth-boundary.test.ts tests/browser-fixture-ownership.test.ts tests/catalog-csv.test.ts tests/push-subscriptions.test.ts tests/telemetry.test.ts",
    "pretest:api": "npm run build:commerce",
    "test:api": "tsx --test tests/api.test.ts tests/api-modernization.test.ts tests/auth-security.test.ts tests/admin-migration.test.ts tests/database.test.ts tests/upload-security.test.ts tests/email-smtp.test.ts tests/drive-google.test.ts tests/push-provider.test.ts tests/telemetry-api.test.ts",
    "pretest:security": "npm run build:commerce",
    "test:security": "tsx --test tests/auth-security.test.ts tests/upload-security.test.ts",
    "test:integration": "npm run build:commerce && node scripts/tooling/test-commerce-integration.mjs",
    "test:performance": "npm run build:commerce && node scripts/tooling/test-commerce-integration.mjs tests/performance-api.test.ts",
    "test:e2e:smoke": "playwright test",
    "audit:security": "node scripts/tooling/audit-dependencies.mjs",
    "dev": "npm run dev --workspace @almina/web --",
    "dev:api": "npm run dev --workspace @almina/api",
    "build:foundation": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "lint": "eslint apps packages tests scripts/tooling scripts/migrations playwright.config.ts",
    "start:web": "npm run start --workspace @almina/web --",
    "start:api": "npm run start --workspace @almina/api",
    "docs:next": "node scripts/tooling/next-docs.mjs",
    "release:gate": "tsx scripts/migrations/release-gate.ts",
    "test:release": "tsx --test tests/release-gate.test.ts",
    "db:indexes:plan": "tsx scripts/migrations/api-indexes.ts",
    "db:indexes:apply": "tsx scripts/migrations/api-indexes.ts --apply",
    "smoke:foundation": "node scripts/tooling/smoke-foundation.mjs",
    "smoke:api": "node scripts/tooling/smoke-api.mjs",
    "smoke:seo": "node scripts/tooling/smoke-seo.mjs",
    "smoke:storefront": "node scripts/tooling/smoke-storefront.mjs",
    "verify:storefront:browser": "node scripts/tooling/verify-storefront-browser.mjs",
    "smoke:catalog-cache": "node scripts/tooling/smoke-catalog-cache.mjs",
    "build:commerce": "node scripts/tooling/build-commerce.mjs",
    "pretest": "npm run build:commerce",
    "prestart": "npm run check:commerce",
    "db:recovery:plan": "tsx scripts/migrations/recovery-bootstrap.ts",
    "db:recovery:apply": "tsx scripts/migrations/recovery-bootstrap.ts --apply",
    "db:recovery:catalog": "tsx scripts/migrations/recovery-catalog.ts",
    "db:commerce:plan": "tsx scripts/migrations/commerce.ts",
    "db:commerce:apply": "tsx scripts/migrations/commerce.ts --apply",
    "test:commerce:integration": "npm run build:commerce && node scripts/tooling/test-commerce-integration.mjs",
    "check:commerce": "node scripts/tooling/check-commerce-build.mjs",
    "verify:commerce:browser": "playwright test tests/e2e/next-checkout.spec.ts tests/e2e/commerce.spec.ts",
    "analyze:web": "node scripts/tooling/analyze-web-bundle.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nbl-ahmd/almina"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nbl-ahmd/almina"
  },
  "homepage": "https://github.com/nbl-ahmd/almina",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "fast-glob": "file:packages/next-glob",
    "mongodb": "7.7.0",
    "mongodb-memory-server-core": "11.3.0",
    "next-devtools-mcp": "0.4.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "next-devtools-mcp": {
      "@modelcontextprotocol/sdk": "1.31.0"
    },
    "fast-glob": "$fast-glob"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "fsevents": false
  }
}
