APP_ENV=staging
NODE_ENV=production
WEB_ORIGIN=https://web.staging.example.invalid
API_ORIGIN=https://api.staging.example.invalid
LOG_LEVEL=info

# Optional read-only legacy catalog service; defaults to API_ORIGIN.
# LEGACY_API_ORIGIN=https://legacy-api.example.invalid
# Permanent compatibility redirects are enabled. Verify production targets before cutover.
STOREFRONT_REDIRECTS_VERIFIED=true

# Reviewed retired public ID -> equivalent live public ID map; targets are validated at request time.
STOREFRONT_PRODUCT_REPLACEMENTS={}
