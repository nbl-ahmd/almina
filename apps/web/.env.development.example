APP_ENV=development
WEB_ORIGIN=http://localhost:3000
# npm run dev starts your full local API using backend/.env.local when both
# API origins are unset. To use an already-running compatibility API, uncomment
# this setting. dev:api starts the full API separately.
# API_ORIGIN=http://127.0.0.1:4000
LOG_LEVEL=info

# Optional separate compatibility catalog service; defaults to API_ORIGIN.
# LEGACY_API_ORIGIN=https://legacy-api.example.invalid
# Permanent compatibility redirects are enabled. Verify production targets before cutover.
STOREFRONT_REDIRECTS_VERIFIED=true

# Reviewed retired public ID -> equivalent live public ID map; targets are validated at request time.
STOREFRONT_PRODUCT_REPLACEMENTS={}

# Admin uses the hardened legacy service for management and shared cookie sessions.
# Its AUTH_ALLOWED_ORIGINS must include WEB_ORIGIN. No database is opened by Next.
# Optional public VAPID key (not a credential); use the same key as the existing push sender.
# ADMIN_PUSH_PUBLIC_KEY=

# Enable only after staging checkout, stock, policy and outbox verification.
CHECKOUT_ENABLED=false

# Existing image delivery account name only; never an API key.
# CLOUDINARY_CLOUD_NAME=your-cloud-name

# Optional anonymous usage reports; enable on both API and web only with consent controls.
COMMERCE_TELEMETRY_ENABLED=false

# Additive Stripe test option; API sandbox must be configured separately.
STRIPE_TEST_ENABLED=false

# Optional PostHog analytics (EU Cloud). The project API key is public; leave blank to keep analytics off.
# POSTHOG_PROJECT_KEY=phc_your_project_key
# Defaults to https://eu.i.posthog.com. Set only for a PostHog managed reverse proxy subdomain.
# POSTHOG_HOST=https://eu.i.posthog.com
# Anonymous counting without cookies for visitors who have not allowed analytics. Enable only after the legal check
# and after turning on cookieless tracking in the PostHog project (otherwise those events are discarded).
POSTHOG_COOKIELESS_ENABLED=false
