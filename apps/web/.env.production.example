APP_ENV=production
NODE_ENV=production
WEB_ORIGIN=https://web.production.example.invalid
API_ORIGIN=https://api.production.example.invalid
LOG_LEVEL=info

# Optional read-only legacy catalog service; defaults to API_ORIGIN.
# LEGACY_API_ORIGIN=https://legacy-api.example.invalid
# Permanent compatibility redirects are enabled. Verify production targets before cutover.
STOREFRONT_REDIRECTS_VERIFIED=true

# Reviewed retired public ID -> equivalent live public ID map; targets are validated at request time.
STOREFRONT_PRODUCT_REPLACEMENTS={}

# Enable only after staging checkout, stock, policy and outbox verification.
CHECKOUT_ENABLED=false

# Existing image delivery account name only; never an API key.
# CLOUDINARY_CLOUD_NAME=your-cloud-name

# Optional anonymous usage reports; enable on both API and web only with consent controls.
COMMERCE_TELEMETRY_ENABLED=false

# Enable only after channel eligibility, approved images and deployed feed validation.
CATALOG_FEEDS_ENABLED=false

# Google Customer Reviews / store widget: keep OFF pending Google eligibility
# confirmation for the UAE pharmacy and approval of the stated data disclosure.
GOOGLE_MERCHANT_ACCOUNT_ID=5884188879
GOOGLE_CUSTOMER_REVIEWS_ELIGIBILITY_CONFIRMED=false
GOOGLE_CUSTOMER_REVIEWS_ENABLED=false
GOOGLE_MERCHANT_WIDGET_ENABLED=false
# Published conservative handling + transit window; weekends are excluded.
GOOGLE_REVIEWS_DELIVERY_BUSINESS_DAYS=6
