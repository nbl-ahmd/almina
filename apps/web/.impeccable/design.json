      "kind": "button",
      "refersTo": "button-primary",
      "description": "Customer button variant; includes source focus and unavailable treatment.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">Add to cart</button>",
      "css": ".ds-button-primary{font-family:Figtree,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1px solid var(--color-brand, #ff5a5f);border-radius:10px;background:var(--color-brand, #ff5a5f);color:var(--color-ink, #24272b);font-size:16px;font-weight:600;line-height:1.3;cursor:pointer;transition:background-color 150ms,border-color 150ms;}.ds-button-primary:hover:not(:disabled){background:var(--color-brand-hover, #ff7478);border-color:var(--color-brand-hover, #ff7478);}.ds-button-primary:focus-visible{outline:2px solid var(--color-focus, #24272b);outline-offset:3px;}.ds-button-primary:disabled{background:var(--color-control-disabled, #eceeed);color:var(--color-muted, #5d6269);border-color:var(--color-border, #d8dadd);}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Ink action",
      "kind": "button",
      "refersTo": "button-ink",
      "description": "Customer button variant; includes source focus and unavailable treatment.",
      "html": "<button class=\"ds-button-ink\" type=\"button\">Explore the range</button>",
      "css": ".ds-button-ink{font-family:Figtree,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1px solid var(--color-ink, #24272b);border-radius:10px;background:var(--color-ink, #24272b);color:var(--color-surface, #ffffff);font-size:16px;font-weight:600;line-height:1.3;cursor:pointer;transition:background-color 150ms,border-color 150ms;}.ds-button-ink:focus-visible{outline:2px solid var(--color-focus, #24272b);outline-offset:3px;}.ds-button-ink:disabled{background:var(--color-control-disabled, #eceeed);color:var(--color-muted, #5d6269);border-color:var(--color-border, #d8dadd);}@media(prefers-reduced-motion:reduce){.ds-button-ink{transition:none;}}"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Customer button variant; includes source focus and unavailable treatment.",
      "html": "<button class=\"ds-button-secondary\" type=\"button\">Continue shopping</button>",
      "css": ".ds-button-secondary{font-family:Figtree,Arial,sans-serif;display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 20px;border:1px solid var(--color-control-border, #8b8f96);border-radius:10px;background:var(--color-surface, #ffffff);color:var(--color-ink, #24272b);font-size:16px;font-weight:600;line-height:1.3;cursor:pointer;transition:background-color 150ms,border-color 150ms;}.ds-button-secondary:focus-visible{outline:2px solid var(--color-focus, #24272b);outline-offset:3px;}.ds-button-secondary:disabled{background:var(--color-control-disabled, #eceeed);color:var(--color-muted, #5d6269);border-color:var(--color-border, #d8dadd);}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
    },
    {
      "name": "Search entry",
      "kind": "input",
      "refersTo": "search",
      "description": "Header entry and submit; suggestions remain an application behaviour.",
      "html": "<form class=\"ds-search\" role=\"search\"><input class=\"ds-search-input\" aria-label=\"Search products\" placeholder=\"Search products or brands\" type=\"search\"><button class=\"ds-search-submit\" type=\"submit\" aria-label=\"Search\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" aria-hidden=\"true\"><path stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3\"/></svg></button></form>",
      "css": ".ds-search{font-family:Figtree,Arial,sans-serif;display:flex;align-items:center;gap:8px;min-height:54px;padding:4px 4px 4px 16px;border:1.5px solid var(--color-ink, #24272b);border-radius:10px;background:var(--color-surface, #ffffff);}.ds-search:focus-within{outline:2px solid var(--color-ink, #24272b);outline-offset:2px;}.ds-search-input{font-family:Figtree,Arial,sans-serif;min-width:0;min-height:44px;flex:1;border:0;background:transparent;padding:0;color:var(--color-ink, #24272b);font-size:16px;}.ds-search-input::placeholder{color:var(--color-muted, #5d6269);}.ds-search-input:focus-visible{outline:none;}.ds-search-submit{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px;padding:0 12px;border:0;border-radius:7px;background:var(--color-brand, #ff5a5f);color:var(--color-ink, #24272b);cursor:pointer;}.ds-search-submit:focus-visible{outline:2px solid var(--color-focus, #24272b);outline-offset:3px;}"
    },
    {
      "name": "Department navigation",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Plain desktop destination with current underline and local hover state.",
      "html": "<nav aria-label=\"Shop navigation\" class=\"ds-navigation\"><a class=\"ds-navigation-link\" href=\"/offers\" aria-current=\"page\">Offers</a><a class=\"ds-navigation-link\" href=\"/brands\">Shop brands</a></nav>",
      "css": ".ds-navigation{font-family:Figtree,Arial,sans-serif;display:flex;flex-wrap:wrap;gap:4px;}.ds-navigation-link{position:relative;display:inline-flex;align-items:center;min-height:48px;padding:0 12px;font-size:13px;font-weight:500;color:var(--color-ink, #24272b);text-decoration:none;}.ds-navigation-link::after{content:\"\";position:absolute;inset-inline:12px;bottom:0;height:2px;border-radius:9999px;background:var(--color-brand, #ff5a5f);transform:scaleX(0);transition:transform 200ms;}.ds-navigation-link[aria-current=page]{font-weight:600;}.ds-navigation-link[aria-current=page]::after,.ds-navigation-link:hover::after{transform:scaleX(1);}.ds-navigation-link:hover{color:var(--color-teal, #175b5a);}.ds-navigation-link:hover:not([aria-current=page])::after{opacity:.4;}.ds-navigation-link:focus-visible{outline:2px solid var(--color-focus, #24272b);outline-offset:3px;}@media(prefers-reduced-motion:reduce){.ds-navigation-link::after{transition:none;}}"
    },
    {
