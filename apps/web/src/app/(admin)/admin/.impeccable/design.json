      "css": ".ds-commerce-metric{display:flex;flex-direction:column;justify-content:space-between;gap:20px;padding:18px 14px;background:var(--admin-surface,#fff);border:1px solid var(--admin-border,#e5e5e5);border-radius:12px;font-family:Geist,Arial,sans-serif}.ds-commerce-metric h2{margin:0;font-size:12px;font-weight:500;line-height:1.4;color:var(--admin-steel,#525252)}.ds-commerce-metric p{margin:0;color:var(--admin-ink,#171717);font-size:clamp(22px,2vw,29px);font-weight:500;line-height:1.15;letter-spacing:-.03em;font-variant-numeric:tabular-nums}.ds-commerce-metric>span{font-size:10px;color:var(--admin-muted,#666)}"
