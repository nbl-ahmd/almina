      "css": ".ds-chart-toggle{display:inline-flex;gap:2px;padding:2px;background:var(--admin-paper,#f5f5f5);border-radius:6px;font-family:Geist,Arial,sans-serif}.ds-chart-toggle button{min-height:28px;padding:4px 8px;font:inherit;font-size:11px;font-weight:500;background:transparent;border:0;box-shadow:none;color:var(--admin-muted,#666);border-radius:4px;cursor:pointer}.ds-chart-toggle button[aria-pressed=\"true\"]{background:var(--admin-surface,#fff);color:var(--admin-ink,#171717)}.ds-chart-toggle button:focus-visible{outline:2px solid var(--admin-ink,#171717);outline-offset:2px}.ds-chart-toggle button:active{transform:scale(.97)}@media(prefers-reduced-motion:reduce){.ds-chart-toggle button:active{transform:none}}"
    }
  ],
  "narrative": {
    "northStar": "Working paper",
    "overview": "Nexadash supplies the legible workbench structure; Dub supplies the neutral, minimal, utilitarian language. White working panels sit on a pale neutral canvas, with a quiet sidebar and precise ink typography. Density supports staff scanning catalogue, orders and reports throughout a shift.\n\nThis system applies only to the administration route and admin components. The storefront retains its own design system. It records the implemented interface, including the final CSS overrides, rather than the superseded warm-paper direction. The dashboard now composes a compact 2\u00d72 metric block, dominant daily chart and fulfilment panel, followed by two working lists. Product editing starts with sales-channel switches and corresponding prices; task tabs retain unsaved fields. Product identity, permissions and server-authoritative commerce remain application constraints; this document records the built interface, not a deployment.",
    "keyCharacteristics": [
      "Neutral chrome and white, border-defined working surfaces.",
      "One optimized Geist family; compact labels and aligned numbers.",
      "Ink actions, blue data marks and semantic status color.",
      "Channel-first pricing and persistent product task tabs."
    ],
    "rules": [
      {
        "name": "The State and Data Rule",
        "body": "Use chromatic color for data and named status. Primary actions and active navigation remain ink-led.",
        "section": "colors"
      },
      {
        "name": "The Reading Rule",
        "body": "A figure names its scope beside the value. Missing data remains unavailable; it does not become a healthy zero or a fabricated comparison.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Working panels are flat at rest. Reserve stronger elevation for transient sheets and popovers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do scope admin styling and portals inside the admin theme.",
      "Do keep numeric columns aligned and status meaning in readable text.",
      "Do preserve unsaved inputs when switching task tabs.",
      "Do retain search terms when changing inventory views.",
      "Do respect reduced motion and keep keyboard focus visible."
    ],
    "donts": [
      "Don't import the storefront palette or restore the superseded warm admin palette.",
      "Don't add decorative brand color to neutral navigation or primary actions.",
      "Don't confuse the all-date recent-order list with period reporting, or invent a comparison without a baseline.",
      "Don't hide primary Edit behind the secondary actions popover.",
      "Don't promote legacy kickers, tiny tracked uppercase labels or stale comments into reusable system rules."
    ]
  }
}
