      "refersTo": "navigation-active",
      "description": "Compact sidebar selection with a white surface and neutral border.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Example\"><a href=\"#products\" aria-current=\"page\">Products</a></nav>",
      "css": ".ds-nav{padding:8px;background:var(--admin-paper,#f5f5f5);font-family:Geist,Arial,sans-serif}.ds-nav a{display:flex;align-items:center;min-height:36px;padding:7px 9px;border:1px solid var(--admin-border,#e5e5e5);border-radius:8px;background:var(--admin-surface,#fff);color:var(--admin-ink,#171717);font-size:13px;font-weight:500;line-height:1.3;text-decoration:none}.ds-nav a:hover{background:var(--admin-paper,#f5f5f5)}.ds-nav a:focus-visible{outline:2px solid var(--admin-ink,#171717);outline-offset:2px}"
