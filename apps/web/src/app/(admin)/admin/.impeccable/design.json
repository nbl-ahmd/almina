      "css": ".ds-field{display:grid;gap:6px;font-family:Geist,Arial,sans-serif;font-size:12px;font-weight:500;color:var(--admin-ink,#171717)}.ds-field input{font:inherit;font-size:13px;min-height:36px;padding:7px 10px;background:var(--admin-surface,#fff);color:var(--admin-ink,#171717);border:1px solid var(--admin-control-border,#d4d4d4);border-radius:6px;transition:border-color 150ms cubic-bezier(.16,1,.3,1)}.ds-field input::placeholder{color:var(--admin-fog,#737373)}.ds-field input:hover{border-color:var(--admin-control-hover,#a3a3a3)}.ds-field input:focus-visible{border-color:var(--admin-ink,#171717);outline:none;box-shadow:0 0 0 3px rgb(26 24 21 / 10%)}"
