      "css": ".ds-button-danger{font-family:Geist,Arial,sans-serif;font-size:13px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:34px;padding:7px 12px;border-radius:8px;cursor:pointer;transition:background-color 150ms cubic-bezier(.16,1,.3,1),transform 120ms cubic-bezier(.23,1,.32,1);background:var(--admin-danger-soft,#fbe9e7);color:var(--admin-danger,#b3261e);border:1px solid transparent;}.ds-button-danger:hover:not(:disabled){background:var(--admin-danger,#b3261e);color:white;}.ds-button-danger:focus-visible{outline:2px solid var(--admin-ink,#171717);outline-offset:2px;}.ds-button-danger:active:not(:disabled){transform:scale(.97);}.ds-button-danger:disabled{background:var(--admin-paper,#f5f5f5);color:var(--admin-faint,#a3a3a3);border-color:var(--admin-border,#e5e5e5);box-shadow:none;cursor:not-allowed;}@media(prefers-reduced-motion:reduce){.ds-button-danger{transition:none;}.ds-button-danger:active:not(:disabled){transform:none;}}"
