      "css": ".ds-badge{display:inline-flex;align-items:center;gap:5px;border-radius:9999px;padding:3px 9px;font-family:Geist,Arial,sans-serif;font-size:11px;font-weight:600;letter-spacing:.01em;line-height:1.45;white-space:nowrap;border:1px solid transparent;color:var(--admin-success,#166f30);background:var(--admin-success-soft,#e4f3e8)}.ds-badge span{width:5px;height:5px;border-radius:9999px;background:currentColor}"
