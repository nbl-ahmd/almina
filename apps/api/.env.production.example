# Versioned-only foundation configuration. Example files are not loaded.
# The full production API (root npm start) uses injected backend settings;
# dev:api uses backend/.env.local or backend/.env and preserves its MONGODB_URI.
APP_ENV=production
NODE_ENV=production
WEB_ORIGIN=https://web.production.example.invalid
API_HOST=0.0.0.0
PORT=4000
DATABASE_MODE=disabled
LOG_LEVEL=info
# Comma-separated exact trusted reverse-proxy IPs; blank means trust none.
API_TRUST_PROXY=
# No production traffic/database connection is enabled by the foundation.
# A later approved read rollout requires DATABASE_MODE=enabled, DATABASE_ENV=production,
# an explicitly reviewed existing MONGODB_DATABASE and a least-privilege MONGODB_URI secret.

# Optional anonymous usage reports; enable on both API and web only with consent controls.
COMMERCE_TELEMETRY_ENABLED=false

# Optional customer sign-in. Configure privately; never use NEXT_PUBLIC_* for secrets.
# Google: OAuth Web application client ID; requires exact authorized storefront origins.
CUSTOMER_GOOGLE_CLIENT_ID=
# Email code sign-in: independent random secret (32+ characters) and Microsoft 365 SMTP mailbox.
CUSTOMER_AUTH_SECRET=
CUSTOMER_EMAIL_USER=
CUSTOMER_EMAIL_PASSWORD=
