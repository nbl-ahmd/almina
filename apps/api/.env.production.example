APP_ENV=production
NODE_ENV=production
WEB_ORIGIN=https://web.production.example.invalid
API_HOST=0.0.0.0
PORT=4000
DATABASE_MODE=disabled
LOG_LEVEL=info
# Comma-separated exact trusted reverse-proxy IPs; blank means trust none.
API_TRUST_PROXY=
# No production traffic/database connection is enabled by the foundation.
# A later approved read rollout requires DATABASE_MODE=enabled, DATABASE_ENV=production,
# an explicitly reviewed existing MONGODB_DATABASE and a least-privilege MONGODB_URI secret.
