{
  "name": "@almina/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/tooling/dev.mjs --api-only",
    "dev:foundation": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "build": "node ../../scripts/tooling/build-api.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@almina/config": "0.1.0",
    "@almina/contracts": "0.1.0",
    "bcryptjs": "3.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jose": "6.2.12",
    "mjml": "5.4.1",
    "mongodb": "7.7.0",
    "nodemailer": "10.0.14",
    "resend": "6.34.1",
    "sanitize-html": "2.18.1",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2"
  }
}
