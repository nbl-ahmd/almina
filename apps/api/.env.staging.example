APP_ENV=staging
NODE_ENV=production
WEB_ORIGIN=https://web.staging.example.invalid
API_HOST=0.0.0.0
PORT=4000
DATABASE_MODE=disabled
LOG_LEVEL=info
# Comma-separated exact trusted reverse-proxy IPs; blank means trust none.
API_TRUST_PROXY=
# Enable only with a separate sanitized staging Atlas database and scoped secret.
# DATABASE_MODE=enabled
# DATABASE_ENV=staging
# MONGODB_DATABASE=almina_staging
# Inject MONGODB_URI through the deployment secret manager; do not put it here.

# Optional anonymous usage reports; enable on both API and web only with consent controls.
COMMERCE_TELEMETRY_ENABLED=false
