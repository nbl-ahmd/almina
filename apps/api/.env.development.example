APP_ENV=development
# dev:api / this workspace's dev command start the full compatibility runtime
# using backend/.env.local, the same MONGODB_URI contract as production.
# These settings apply to dev:api:foundation only (versioned /api/v1 API).
WEB_ORIGIN=http://localhost:3000
API_HOST=127.0.0.1
PORT=4000
DATABASE_MODE=disabled
LOG_LEVEL=info
# Comma-separated exact trusted reverse-proxy IPs; blank means trust none.
API_TRUST_PROXY=

# Optional anonymous usage reports; enable on both API and web only with consent controls.
COMMERCE_TELEMETRY_ENABLED=false
